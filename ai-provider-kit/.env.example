# ============================================================
# AI PROVIDER
# Accepted values: gemini | openai | codex
# ============================================================
AI_PROVIDER=gemini

# ============================================================
# Google Gemini (default)
# Get your key: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# OpenAI API
# Get your key: https://platform.openai.com/api-keys
# Recommended models: gpt-4o-mini (fast/cheap), gpt-4o (best quality)
# ============================================================
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Codex CLI (optional — only if using AI_PROVIDER=codex)
# Requires the `codex` binary to be on your PATH.
# Leave blank to inherit OPENAI_MODEL above.
# ============================================================
# CODEX_CLI_PATH=codex
# CODEX_MODEL=gpt-4o-mini
