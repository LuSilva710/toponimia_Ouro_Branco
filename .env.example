# ============================================================
# Supabase — Banco de dados do projeto
# ============================================================
VITE_SUPABASE_URL=https://vtsuctcmycaiooeubjnk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# AI PROVIDER — Chatbot (Browser / Frente 1)
# Seleciona o provider da IA no chatbot. Valores aceitos:
#   gemini     → Google Gemini REST API (padrão, gratuito)
#   openai     → OpenAI Chat Completions
#   openrouter → OpenRouter (proxy multi-modelo)
# ============================================================
VITE_AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_MODEL=gemini-2.0-flash

# OpenAI — https://platform.openai.com/api-keys (opcional)
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter — https://openrouter.ai/keys (opcional)
# VITE_OPENAI_API_KEY=sk-or-v1-...
# VITE_OPENAI_MODEL=openai/gpt-4o-mini
# VITE_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# AI PROVIDER — Scripts Node.js / ai-provider-kit (Frente 2)
# Usado por: node scripts/ai-classify.mjs
# Valores aceitos: gemini | openai | codex
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# CODEX_CLI_PATH=codex
# CODEX_MODEL=gpt-4o-mini
