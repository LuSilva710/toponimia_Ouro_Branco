# ============================================================
# Supabase — Banco de dados do projeto
# Obrigatório para o app funcionar (Home, mapa, admin, jogos…).
# ============================================================
VITE_SUPABASE_URL=https://vtsuctcmycaiooeubjnk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# Mapa — basemap CARTO (opcional)
# Sem esta chave, use o toggle OSM no mapa. Com chave, CARTO Light funciona.
# https://carto.com/basemaps/#apikey
# ============================================================
# VITE_CARTO_API_KEY=

# ============================================================
# AI PROVIDER — Chatbot ONIM (Browser)
# Qualquer VITE_* entra no bundle público — não use service role aqui.
# Valores: gemini | openai | openrouter
# ============================================================
VITE_AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
# Com VITE_AI_PROVIDER=openai + Groq: mantenha também VITE_GEMINI_* para o agente
# alternar quando a cota Groq acabar. Embeddings do agente usam Gemini.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Chat: use 2.x (ex.: gemini-2.0-flash). Modelos gemini-1.5-* costumam 404.
VITE_GEMINI_MODEL=gemini-2.0-flash

# OpenAI / Groq / compatível — https://console.groq.com/keys
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=llama-3.1-8b-instant
# VITE_OPENAI_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter — https://openrouter.ai/keys
# Aceita VITE_OPENAI_API_KEY OU VITE_OPENROUTER_API_KEY (alias no ai-client).
# VITE_OPENAI_API_KEY=sk-or-v1-...
# VITE_OPENROUTER_API_KEY=sk-or-v1-...
# VITE_OPENAI_MODEL=openai/gpt-4o-mini
# VITE_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Ollama (fallback local opcional)
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=qwen2.5:3b

# ============================================================
# Scripts Node (NÃO prefixar com VITE_ — não vão para o browser)
# Usado por: npm run ai:classify, generate-embeddings, etc.
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# CODEX_CLI_PATH=codex
# CODEX_MODEL=gpt-4o-mini

# Service role — SOMENTE scripts server-side / embeddings. Nunca no Vite.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
