# ============================================================
# Supabase — Banco de dados do projeto
# Obrigatório para o app funcionar (Home, mapa, admin, jogos…).
# ============================================================
VITE_SUPABASE_URL=https://vtsuctcmycaiooeubjnk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================
# Mapa — basemap CARTO (opcional)
# Sem esta chave, use o toggle OSM no mapa. Com chave, CARTO Light funciona.
# https://carto.com/basemaps/#apikey
# ============================================================
# VITE_CARTO_API_KEY=

# ============================================================
# Chatbot ONIM — as chaves de IA NÃO ficam aqui.
# Qualquer VITE_* entra no bundle público. O chatbot chama a Edge Function
# supabase/functions/onim-chat, que guarda as chaves como secrets do Supabase.
# Ver supabase/functions/README.md.
# ============================================================

# ============================================================
# Scripts Node (NÃO prefixar com VITE_ — não vão para o browser)
# Usado por: npm run ai:classify, generate-embeddings, etc.
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# CODEX_CLI_PATH=codex
# CODEX_MODEL=gpt-4o-mini

# Service role — SOMENTE scripts server-side / embeddings. Nunca no Vite.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
