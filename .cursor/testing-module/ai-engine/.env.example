# ============================================================
# AI PROVIDER — escolha entre Google Gemini ou OpenAI/Codex
# ============================================================

# Valores aceitos: gemini | openai | codex (codex = alias de openai)
AI_PROVIDER=gemini

# ============================================================
# Google Gemini (padrão)
# Obter chave: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# OpenAI / Codex CLI
# Obter chave: https://platform.openai.com/api-keys
# Modelos recomendados: gpt-4o-mini (rápido/barato), gpt-4o (melhor)
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Targets
# ============================================================

# URL base para testes de API (HTTP/REST)
TARGET_BASE_URL=http://localhost:3000

# URL para testes de browser (Playwright)
TARGET_BROWSER_URL=http://localhost:3000

# ============================================================
# Autenticação — testes reais com login
# ============================================================

# Credenciais de teste (usuário de staging/homologação, nunca produção!)
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Test@1234

# URL de login do sistema (browser flow)
# O Playwright vai navegar até aqui e fazer login automaticamente
TEST_AUTH_URL=/login

# Endpoint da API de login (para testes de API autenticados)
# O engine vai fazer POST aqui, extrair o JWT e usar nos próximos testes
TEST_AUTH_ENDPOINT=/api/auth/login

# Seletores de login (opcional — o engine tenta descobrir automaticamente)
# TEST_USERNAME_SELECTOR=input[name=email]
# TEST_PASSWORD_SELECTOR=input[type=password]
# TEST_SUBMIT_SELECTOR=button[type=submit]

# Seletor que indica que o usuário está autenticado (opcional)
# TEST_AUTH_INDICATOR=[data-user],.avatar,.user-menu

# ============================================================
# Opções do engine
# ============================================================

# Modo de execução: all | api | browser | generate
RUN_MODE=all

# Máximo de casos por contrato gerados pela IA
MAX_CASES_PER_CONTRACT=20

# Caminho para contratos (relativo à raiz do repo)
CONTRACTS_PATH=.cursor/contracts

# Caminhos dos relatórios gerados
AI_REPORT_PATH=.cursor/testing-module/reports/ai-final-report.json
AI_HTML_REPORT_PATH=.cursor/testing-module/reports/ai-final-report.html
