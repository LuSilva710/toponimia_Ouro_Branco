{
  "version": "1.0.0",
  "description": "Casos pre-definidos para modo offline (sem provider IA).",
  "cases": [
    {
      "id": "offline.contract_smoke.health",
      "type": "contract_smoke",
      "description": "Verifica se /api/health responde < 500",
      "endpoint": "/api/health",
      "method": "GET",
      "expectedStatusBelow": 500
    },
    {
      "id": "offline.field_validation.email_required",
      "type": "field_validation",
      "description": "Campo email obrigatorio nao pode estar vazio",
      "field": "email",
      "rule": "required"
    },
    {
      "id": "offline.field_validation.password_min",
      "type": "field_validation",
      "description": "Senha precisa ter pelo menos 6 caracteres",
      "field": "password",
      "rule": "minLength",
      "value": 6
    },
    {
      "id": "offline.mask_validation.cpf",
      "type": "mask_validation",
      "description": "Mascara de CPF deve seguir XXX.XXX.XXX-XX",
      "field": "cpf",
      "regex": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    }
  ]
}
