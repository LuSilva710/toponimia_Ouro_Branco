  "mocks": {
    "GET /api/health": {
      "status": 200,
      "body": { "status": "ok", "version": "mock" }
    },
    "POST /api/auth/login": {
      "status": 200,
      "body": { "token": "rovis-mock-token-valid", "user": { "id": "user-test-1" } }
    },
    "GET /api/users": {
      "status": 200,
      "body": { "items": [], "total": 0 }
    }
  },
  "rules": {
    "useMocksWhenBackendUnreachable": true,
    "useSeedForLogin": true,
    "deterministicTimestamps": true,
    "frozenDate": "2026-01-01T00:00:00Z"
  }
}
