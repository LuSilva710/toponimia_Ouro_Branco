{
  "version": "1.0.0",
  "description": "Seed e mocks para testes deterministicos sem backend real.",
  "enabled": false,
  "seed": {
    "users": [
      {
        "id": "user-test-1",
        "email": "test@rovis.local",
        "password": "Test@123",
        "role": "admin"
      },
      {
        "id": "user-test-2",
        "email": "viewer@rovis.local",
        "password": "Test@123",
        "role": "viewer"
      }
    ],
    "tokens": {
      "valid":   "rovis-mock-token-valid",
      "expired": "rovis-mock-token-expired"
    }
