{
    "pipelineContext": {
        "buildId": "local-manual",
        "commitSha": "dev",
        "environment": "local"
    },
    "scope": {
        "backend": true,
        "frontend": true,
        "masks": true,
        "validations": true
    },
    "targets": {
        "backendMethods": [
            {
                "name": "real-check:runner-script-exists",
                "invoke": {
                    "type": "command",
                    "command": "Test-Path .cursor/testing-module/scripts/Run-TestModule.ps1"
                },
                "expectedContains": "True"
            },
            {
                "name": "real-check:init-file-exists",
                "invoke": {
                    "type": "command",
                    "command": "Test-Path .cursor/init.md"
                },
                "expectedContains": "True"
            },
            {
                "name": "real-check:agent-scorecard",
                "invoke": {
                    "type": "command",
                    "command": "powershell -ExecutionPolicy Bypass -File .cursor/testing-module/scripts/Check-AgentScorecard.ps1"
                },
                "expectedContains": "AGENT_SCORECARD_OK"
            }
        ],
        "frontendFlows": [
            {
                "name": "Cadastro básico",
                "route": "/cadastro",
                "invoke": {
                    "type": "command",
                    "command": "Write-Output \u0027FLOW_OK\u0027"
                },
                "expectedContains": "FLOW_OK"
            }
        ],
        "fieldValidations": [
            {
                "field": "email",
                "rule": "required",
                "validValue": "dev@empresa.com",
                "invalidValue": ""
            }
        ],
        "maskValidations": [
            {
                "field": "cpf",
                "maskPattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$",
                "validSamples": [
                    "123.456.789-10"
                ],
                "invalidSamples": [
                    "12345678910",
                    "123.456.789-1"
                ]
            }
        ]
    },
    "generation": {
        "strategy": "hybrid",
        "maxCasesPerTarget": 100,
        "contractsPath": ".cursor/contracts",
        "fuzz": {
            "enabled": true,
            "iterations": 3
        },
        "contractBindings": [
            {
                "endpoint": "/testing-automation/run",
                "method": "POST",
                "command": "Write-Output \u0027POST /testing-automation/run contract-smoke\u0027",
                "expectedContains": "/testing-automation/run"
            }
        ]
    }
}